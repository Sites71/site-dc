{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Limon",
  "version": "1.0.0",
  "identifier": "com.limon.chat",
  "build": {
    "frontendDist": "../site",
    "beforeDevCommand": "npm run copy",
    "beforeBuildCommand": "npm run copy"
  },
  "app": {
    "windows": [
      {
        "title": "Limon",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
